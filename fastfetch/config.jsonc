{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logos/Anya-Forger-PNG-Isolated-File.png",
        "padding": {
            "top": 1,
            "right": 0
        }
    },

    "display": {
        "separator": " "
    },

    "modules": [
        {
            "key": "╔═══════════╗",
            "type": "custom"
        },

        {
            "key": "║ {#31} user    {#keys}║",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "║ {#32}󰇅 hname   {#keys}║",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "║ {#33}󰅐 uptime  {#keys}║",
            "type": "uptime"
        },
        {
            "key": "║ {#34}{icon} distro  {#keys}║",
            "type": "os",
            "format": "{name} {version-id}"
        },
        {
            "key": "║ {#35}󰌢 host    {#keys}║",
            "type": "host"
        },
        {
            "key": "║ {#36} kernel  {#keys}║",
            "type": "kernel",
            "format": "{release}"
        },
        {
            "key": "║ {#32} shell   {#keys}║",
            "type": "shell"
        },
        {
            "key": "║ {#33}󰇄 de      {#keys}║",
            "type": "de"
        },
        {
            "key": "║ {#34} wm      {#keys}║",
            "type": "wm"
        },
        {
            "key": "║ {#35} term    {#keys}║",
            "type": "terminal"
        },
        {
            "key": "║ {#31}󰍛 cpu     {#keys}║",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "║ {#32}󰢮 gpu     {#keys}║",
            "type": "gpu"
        },
        {
            "key": "║ {#33} memory  {#keys}║",
            "type": "memory"
        },
        {
            "key": "║ {#34}󰉉 disk    {#keys}║",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "╚═══════════╝",
            "type": "custom"
        }
    ]
}
