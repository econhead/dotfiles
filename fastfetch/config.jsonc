{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logos/Anya-Forger-PNG-Isolated-File.png",
        "padding": {
            "top": 2,
            "right":0
        }
    },
"display": {
    "separator": ": ",
    "key": {
        "width": 10
    }
},
       "modules": [
        "title",
        "separator",

        {
            "type": "os",
            "key": "OS",
            "format": "{name} {version-id}"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "terminalfont",
            "key": "Font"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "disk",
            "key": "Disk"
        },
        {
            "type": "battery",
            "key": "Battery"
        },

        "break",
        // "colors"
    ]
}
